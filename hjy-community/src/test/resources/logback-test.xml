<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 测试只输出控制台，避免沿用部署日志目录并触碰工作区外的文件。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
